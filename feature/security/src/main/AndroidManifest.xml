<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".widget.WalletWidgetReceiver"
            android:exported="true"
            android:label="@string/security_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wallet_widget_info" />
        </receiver>

        <activity
            android:name=".widget.QuickAddWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.StudentWallet.QuickAddDialog"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
